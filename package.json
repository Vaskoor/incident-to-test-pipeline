{
  "name": "incident-to-test-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Incident-to-Test Pipeline — closed-loop regression automation (capture → LLM generate → CI gate → verify fix → track recurrence)",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck || true",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": { "express": "^4.21.2" },
  "devDependencies": { "typescript": "^5.7.2", "tsx": "^4.19.2", "@types/express": "^5.0.0", "@types/node": "^22.10.1" }
}
